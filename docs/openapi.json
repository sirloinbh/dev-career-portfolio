  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "English error message"
          }
        },
        "required": [
          "error"
        ]
      },
      "Application": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "position": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100,
            "default": null
          },
          "postingUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500,
            "default": null
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "status": {
            "type": "string",
            "enum": [
              "drafting",
              "submitted",
              "closed"
            ]
          },
          "memo": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "default": null
          }
        },
        "required": [
          "companyName",
          "status"
        ]
      },
      "Career": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "department": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100,
            "default": null
          },
          "position": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100,
            "default": null
          },
          "employmentType": {
            "type": "string",
            "enum": [
              "full_time",
              "contract",
              "intern",
              "freelance",
              "other"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "duties": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "default": null
          },
          "achievements": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "default": null
          }
        },
        "required": [
          "company",
          "employmentType",
          "startDate"
        ]
      },
      "Certification": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
