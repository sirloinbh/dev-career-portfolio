# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=개발 커리어 포트폴리오 weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/dev-career-portfolio
ExecStart=/bin/bash -c 'cp /opt/dev-career-portfolio/deploy/backup.sh /tmp/career-restore-check.sh && exec /bin/bash /tmp/career-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
