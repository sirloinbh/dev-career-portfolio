# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Dev Career weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/dev-career-portfolio
ExecStart=/bin/bash -c 'cp /opt/dev-career-portfolio/deploy/backup.sh /tmp/career-restore-check.sh && exec /bin/bash /tmp/career-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
