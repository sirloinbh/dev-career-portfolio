# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Dev Career daily database dump (and S3 copy when configured)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/dev-career-portfolio
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/dev-career-portfolio/deploy/backup.sh /tmp/career-backup.sh && exec /bin/bash /tmp/career-backup.sh dump'
TimeoutStartSec=30min
Nice=10
