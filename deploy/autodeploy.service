# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=개발 커리어 포트폴리오 pull-based deployment of origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/dev-career-portfolio
# Copied first: the deploy checks out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/dev-career-portfolio/deploy/autodeploy.sh /tmp/career-autodeploy.sh && exec /bin/bash /tmp/career-autodeploy.sh'
TimeoutStartSec=45min
Nice=10
