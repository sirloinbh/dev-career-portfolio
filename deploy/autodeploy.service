# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Dev Career pull-based deployment of origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/dev-career-portfolio
# Copied first: the deploy checks out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/dev-career-portfolio/deploy/autodeploy.sh /tmp/career-autodeploy.sh && exec /bin/bash /tmp/career-autodeploy.sh'
TimeoutStartSec=45min
Nice=10
