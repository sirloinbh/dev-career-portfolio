# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=개발 커리어 포트폴리오 health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/dev-career-portfolio
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/dev-career-portfolio/deploy/notify.sh /tmp/career-notify.sh && exec /bin/bash /tmp/career-notify.sh health'
TimeoutStartSec=2min
