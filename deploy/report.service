# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Dev Career daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/dev-career-portfolio
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/dev-career-portfolio/deploy/report.sh /tmp/career-report.sh && exec /bin/bash /tmp/career-report.sh'
TimeoutStartSec=5min
